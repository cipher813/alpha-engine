{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "SSMParameterStoreRead",
            "Effect": "Allow",
            "Action": [
                "ssm:GetParametersByPath",
                "ssm:GetParameter"
            ],
            "Resource": [
                "arn:aws:ssm:us-east-1:711398986525:parameter/alpha-engine/*",
                "arn:aws:ssm:us-east-1:711398986525:parameter/vires/*",
                "arn:aws:ssm:us-east-1:711398986525:parameter/symposion/LITELLM_MASTER_KEY"
            ]
        }
    ]
}
